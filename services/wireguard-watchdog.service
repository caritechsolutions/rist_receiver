[Unit]
Description=WireGuard/RIST Watchdog Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/wireguard-watchdog.sh
Restart=always
RestartSec=10
StandardOutput=null
StandardError=journal
SyslogIdentifier=wireguard-watchdog

[Install]
WantedBy=multi-user.target
